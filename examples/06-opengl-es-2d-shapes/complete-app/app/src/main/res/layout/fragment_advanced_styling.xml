<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <TextView
        android:id="@+id/tvAdvancedStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1565C0"
        android:padding="12dp"
        android:text="Advanced Styling: Tap to draw polygon, then apply shaders and fill modes!"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF">

        <com.example.test.AdvancedStylingView
            android:id="@+id/advancedStylingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAdvClosePolygon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#4CAF50"
                    android:text="Close Polygon"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnAdvUndo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#757575"
                    android:text="Undo"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnAdvClear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:backgroundTint="#E53935"
                    android:text="Clear"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Fill Mode:"
                android:textColor="#333333"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgFillMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbFillAndStroke"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Fill &amp; Stroke"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/rbFillOnly"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fill Only"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/rbStrokeOnly"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Stroke Only"
                    android:textSize="11sp" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Shader / Fill Effect:"
                android:textColor="#333333"
                android:textSize="12sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <RadioGroup
                    android:id="@+id/rgShaderType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbLinearGradient"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Linear Gradient"
                        android:textSize="11sp" />

                    <RadioButton
                        android:id="@+id/rbRadialGradient"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Radial Gradient"
                        android:textSize="11sp" />

                    <RadioButton
                        android:id="@+id/rbSweepGradient"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sweep Gradient"
                        android:textSize="11sp" />

                    <RadioButton
                        android:id="@+id/rbTexturePattern"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Texture Fill"
                        android:textSize="11sp" />

                    <RadioButton
                        android:id="@+id/rbSolid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Solid Color"
                        android:textSize="11sp" />
                </RadioGroup>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/layoutTextureOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Texture Pattern:"
                    android:textColor="#333333"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgTexturePattern"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbCheckerboard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="Checker"
                        android:textSize="10sp" />

                    <RadioButton
                        android:id="@+id/rbHatch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hatch"
                        android:textSize="10sp" />

                    <RadioButton
                        android:id="@+id/rbDots"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Dots"
                        android:textSize="10sp" />

                    <RadioButton
                        android:id="@+id/rbBrick"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Brick"
                        android:textSize="10sp" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStrokeWidthLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stroke Width: 8px"
                    android:textColor="#333333"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/sbStrokeWidth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="30"
                    android:progress="8" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
